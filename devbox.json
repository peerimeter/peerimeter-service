{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": ["postgresql@18.6"],
  "shell": {
    "init_hook": [
      "export PGHOST=\"${TMPDIR:-/tmp}/peerimeter-pg\""
    ],
    "scripts": {
      "postgres-init": "mkdir -p \"$PGDATA\" \"$PGHOST\" && initdb -D \"$PGDATA\"",
      "postgres-up": "mkdir -p \"$PGHOST\" && pg_ctl -D \"$PGDATA\" -l \"$PGDATA/server.log\" -o \"-k $PGHOST\" start",
      "postgres-down": "pg_ctl -D \"$PGDATA\" stop -m fast",
      "postgres-create-test-db": "createdb peerimeter_test"
    }
  }
}
