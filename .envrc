#!/usr/bin/env bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

devbox_envrc="$(devbox generate direnv --print-envrc)" || {
  echo "Unable to load the Devbox environment" >&2
  return 1
}
eval "$devbox_envrc"

# Keep the Unix socket path short enough for Android/Termux AF_UNIX limits.
export PGHOST="${TMPDIR:-/tmp}/peerimeter-pg-$(id -u)"
mkdir -p "$PGHOST" || return 1
if [ ! -O "$PGHOST" ]; then
  echo "PostgreSQL socket directory is not owned by the current user: $PGHOST" >&2
  return 1
fi
chmod 700 "$PGHOST" || return 1

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

dotenv_if_exists .env
