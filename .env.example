CGO_ENABLED=0
PEERIMETER_API_KEY=local-development-only
PEERIMETER_STORAGE_BACKEND=file
# Required only for the PostgreSQL backend; use a dedicated database URL.
# PEERIMETER_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PEERIMETER_DATA_FILE=./data/config.json
PEERIMETER_LISTEN_ADDR=127.0.0.1
PEERIMETER_PUBLIC_API_URL=http://localhost:8080
# Local development only. Keep HTTPS required in production.
PEERIMETER_REQUIRE_HTTPS=false
# Local dashboard origin; replace with exact dashboard origins for deployment.
PEERIMETER_CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
