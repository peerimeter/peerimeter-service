CGO_ENABLED=0
PEERIMETER_API_KEY=local-development-only
# Used by compose.yaml. Generate a URI-safe password with openssl rand -hex 32.
POSTGRES_USER=peerimeter
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-password
POSTGRES_DB=peerimeter
# Optional remote PostgreSQL/Supabase URL override for compose.yaml.
# Remote databases require certificate and hostname verification.
# PEERIMETER_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# Set PEERIMETER_STORAGE_BACKEND=postgres for PostgreSQL storage; service default is file.
# Set PEERIMETER_IMPORT_SIDECAR_ONLY=true only when importing sidecars without config.json.
PEERIMETER_DATA_FILE=./data/config.json
PEERIMETER_LISTEN_ADDR=127.0.0.1
PEERIMETER_PUBLIC_API_URL=http://localhost:8080
# Local development only. Keep HTTPS required in production.
PEERIMETER_REQUIRE_HTTPS=false
# Local dashboard origin; replace with exact dashboard origins for deployment.
PEERIMETER_CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
